# Runner identity/config
RUNNER_NAME=bybit-new-listings
RUNNER_EXCHANGE=bybit
SCAN_INTERVAL_MS=60000
BYBIT_API_BASE=https://api.bybit.com
LOG_LEVEL=info

# Required for DB writes
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLE_POLLING=true

TELEGRAM_TICKER_URL_TEMPLATE=


RUNNER_CONFIG_PATH=config/app.yaml

# Extreme Sell Pressure v6.4 overrides (optional)
# ESP_V64_LEVERAGE=5
# ESP_V64_TAKE_PROFIT_PCT=4
# ESP_V64_REPLACE_LOSING_THRESHOLD_PCT=5
# ESP_V64_MAX_HOLD_HOURS=48
# ESP_V64_MAX_OPEN_POSITIONS=15
# ESP_V64_PREVENT_DUPLICATE_SYMBOL_ENTRIES=true
# ESP_V64_SELL_RATIO_MAX=0.2
# ESP_V64_MIN_HOUR_VOLUME=1000000
#
# Legacy ESP_V43_* names are still accepted as fallback.
